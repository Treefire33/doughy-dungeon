; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Midnight Dungeons"
config/description="Roguelite RPG dungeon crawler"
config/version="0.0.3"
run/main_scene="uid://b8euto25wvt14"
config/use_custom_user_dir=true
config/custom_user_dir_name="MidnightDungeons"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://cj15p8jw5xygt"
config/icon="uid://b1yk2sgwhouw1"

[aseprite]

animation/layers/only_include_visible_layers_by_default=true
import/import_plugin/default_automatic_importer="Static Texture"

[autoload]

ToastParty="*uid://buwed4tb4brns"
debug_console="*uid://bcs4bvx7fi2hm"
DialogueManager="*uid://c3rodes2l3gxb"
Enum="*res://Scripts/AutoLoad/enums.gd"
Audio="*res://Scripts/AutoLoad/audio.gd"
Keybinds="*res://Scripts/AutoLoad/keybinds.gd"
Settings="*res://Scripts/AutoLoad/settings.gd"
GlobalRandom="*uid://vfhktqgw8axb"
ItemUtils="*res://Scripts/Items/item_utils.gd"
GlobalPlayer="*res://Scripts/AutoLoad/global_player.gd"
MidnightDebug="*res://Scripts/AutoLoad/midnight_debug.gd"
AccessibilityHelper="*uid://b0g45ldc0cbhi"
RPGManager="*uid://blntkoo1yvmv7"
RPGEventBus="*uid://07mj5ajgs8um"
TooltipManager="*uid://brqdjqtp7oci6"
TooltipPlaceholderVariables="*uid://nel5st3wktcw"
TooltipLinkData="*uid://bjkjmtptqed1y"
SuperLoader="*uid://dw6auv6ikfe3f"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0

[dialogue_manager]

runtime/balloon_path="res:///balloon.tscn"
editor/new_file_template="~ start
=> END"

[display]

window/size/viewport_width=800
window/size/viewport_height=450
window/stretch/aspect="ignore"
window/stretch/scale_mode="integer"
window/per_pixel_transparency/allowed=true
mouse_cursor/custom_image="uid://ler003tb368l"

[dotnet]

project/assembly_name="MidnightDungeons"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/copper_dc/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/midnight_resource_translator/plugin.cfg", "res://addons/toastparty/plugin.cfg", "res://addons/tooltips_pro/plugin.cfg")

[file_customization]

folder_colors={
"res://Audio/": "yellow",
"res://Dialogue/": "orange",
"res://Dungeons/": "orange",
"res://EnemyData/": "orange",
"res://Items/": "orange",
"res://Items/Functions/": "gray",
