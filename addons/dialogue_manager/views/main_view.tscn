[node name="CodeEdit" parent="Margin/Content/CodePanel" unique_id=302141693 instance=ExtResource("2_f73fm")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_colors/font_color = Color(1, 1, 1, 0.75)
theme_override_colors/background_color = Color(0.103039995, 0.103039995, 0.103039995, 1)
theme_override_colors/current_line_color = Color(1, 1, 1, 0.07)
theme_override_fonts/font = ExtResource("7_y6rqu")
theme_override_font_sizes/font_size = 14
theme_override_colors/bookmark_color = Color(1, 0.333333, 0.333333, 1)
text = "~ start
Vendor: [#happy] Hey there!
Midnight: [#surprised] !!!
Vendor: No need to panic! I'm not gonna hurt ya or anything! I'm an ally!
Midnight: [#tired] ...
Vendor: The name's Stell and I'm the vendor of this here...
Vendor: [#sideeye] uh...
Vendor: Dungeon shop.
Vendor: You've bought from me before, just needed to observe you a bit more before introducing myself.
Vendor: [#happy]  So, feel free to ask me any question that comes to mind!
...
- What are these items? => vendor_response
- How did you transform? => vendor_response
- The errors? [if GlobalPlayer.get_flag(&\"iEvilScore\") > 0 /] => vendor_error
- Nothing => vendor_exit
=> END

~ vendor_response
Vendor: [#confused] Sorry?
Vendor: [#sad] I don't quite understand you, my apologies.
Vendor: Perhaps another time?
=> vendor_exit

~ vendor_error
ERROR: [#vendor] It stares through the eyes of its new friend.
ERROR: [#vendor] What does it want from you?
ERROR: [#vendor] Well, you'll be meeting soon enough.
ERROR: [#vendor] Only {{3 - GlobalPlayer.get_flag(&\"iEvilScore\")}} more times...
=> vendor_exit

~ vendor_exit
Vendor: Well, if you need anything else, I'll be in the next saferoom!
Vendor: [#happy] So long!
$> GlobalPlayer.set_bool_flag(&\"bVendorMet\", true)
=> END
"
scroll_smooth = true
scroll_vertical = 18.0
syntax_highlighter = SubResource("SyntaxHighlighter_xv2j4")

