import "res://Dialogue/rpg_item_unlock.dialogue" as rpg_item_unlock

~ start
if GlobalPlayer.get_bool_flag(&"bErrorWorld") 
	=> talked
[speed=0.25]You found something out of place.
[speed=0.25]It stares at you, no, through you, though it seems to hear you.
[speed=0.25]It begins to speak, to ask you a question.
[speed=0.25]... Only it didn't speak
[speed=0.25]Instead it stood still, tears welling in its eyes, begging you to hear its pleas through body alone.
[speed=0.25]... But you couldn't.
[speed=0.25]You remained silent, unanswering.
[speed=0.25]Lowering its head, it began to walk away.
[speed=0.25]As it left, you couldn't help but feel sorry, as if there was a way to help.
[speed=0.25]... And there was.
[speed=0.25]This would be the last time you'd meet, and so you ushered it back, palm outstretched-
[speed=0.25]And offered it a gift.
$> GlobalPlayer.add_rpg_item(&"ErroneousGlaive")
=>< rpg_item_unlock/start

[speed=0.25]And then you parted ways.
$> GlobalPlayer.set_bool_flag(&"bErrorWorld", true)
$> Audio.change_music(0)
=> END

~ talked
[speed=0.25]You didn't come back.
=> END
