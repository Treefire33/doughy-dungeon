[gd_resource type="Resource" script_class="DialogueData" format=3 uid="uid://dvqys2tlhakfh"]

[ext_resource type="Script" uid="uid://c1wkyurcxei88" path="res://Scripts/Dialogue/dialogue_speech.gd" id="1_0jg1x"]
[ext_resource type="Script" uid="uid://18dcduftlk12" path="res://Scripts/Dialogue/dialogue_data.gd" id="2_4yfxp"]

[sub_resource type="Resource" id="Resource_bwdcm"]
script = ExtResource("1_0jg1x")
character = 0
speech = "Welcome to Midnight Dungeons! This is the dungeon demo, so you'll only get to play the dungeons (two of them).

Press [[Primary]] to advance dialogue."

[sub_resource type="Resource" id="Resource_5a4q2"]
script = ExtResource("1_0jg1x")
character = 0
speech = "This game is primarily played using both the keyboard and mouse, however there are certain keybinds and toggles meant to allow for use of one or the other."
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_0jg1x"]
script = ExtResource("1_0jg1x")
character = 0
speech = "You can also press [[Secondary]] to instantly complete any dialogue! This acts as a sort of \"skip\". Holding [[Tertiary]] will skip through all dialogue.
"

[sub_resource type="Resource" id="Resource_kfy6o"]
script = ExtResource("1_0jg1x")
character = 0
speech = "Pressing [[Pause]] will pause the game. Pressing [[Tertiary]] will bring up the RPG menu (this is where your global inventory is). Lastly holding [[Quaternary]] while moving will allow you to sprint."

[sub_resource type="Resource" id="Resource_ese38"]
script = ExtResource("1_0jg1x")
character = 0
speech = "Also, make sure to check your inventory ([[Tertiary]]) after completing a dungeon!"
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_wd4li"]
script = ExtResource("1_0jg1x")
character = 0
speech = "That's all! Have fun playing the game!"

[resource]
script = ExtResource("2_4yfxp")
