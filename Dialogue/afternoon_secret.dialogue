import "res://Dialogue/rpg_item_unlock.dialogue" as rpg_item_unlock

~ start
Afternoon: Hey it's me, Afternoon! And this is my sister, Evening!
Afternoon: I'm blue, and now you are too!
[$> speaker.set_enabled(false)] *Afternoon and their sister disappeared, leaving behind a perfect replica of Afternoon's cloak*
$> GlobalPlayer.set_bool_flag(&"bMetAfternoon", true)

$> GlobalPlayer.add_rpg_item(&"AfternoonCloak")
=>< rpg_item_unlock/start
=> END