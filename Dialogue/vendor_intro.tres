emotion = 3
speech = "Hey there!"
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_xdp8d"]
script = ExtResource("1_vyvsa")
character = 2
speech = "Apologies for the frightening entrance, it's just I feel I've seen you before?"
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_64q3m"]
script = ExtResource("1_vyvsa")
emotion = 2
speech = "...?"
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_2qlhb"]
script = ExtResource("1_vyvsa")
character = 2
emotion = 1
speech = "Wait, I've got it!"
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_j8m5q"]
script = ExtResource("1_vyvsa")
character = 2
emotion = 3
speech = "You're that new kid from the guild! Midnight, I believe?"
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_2po8i"]
script = ExtResource("1_vyvsa")
