[sub_resource type="Resource" id="Resource_mv37d"]
script = ExtResource("1_vyvsa")
character = 2
emotion = 4
speech = "I'll take that as a yes..."
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_glxmw"]
script = ExtResource("1_vyvsa")
character = 2
speech = "Anyways, name's Stell, but you can just refer to me as the Vendor. I'm usually lurking about these dungeons, selling useful items to any dungeon crawler making their way through."
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_vyvsa"]
script = ExtResource("1_vyvsa")
character = 2
speech = "Normally I'd try my best not to interact with them, but..."
metadata/_custom_type_script = "uid://c1wkyurcxei88"

[sub_resource type="Resource" id="Resource_uj213"]
script = ExtResource("1_vyvsa")
emotion = 2
speech = "?"

[sub_resource type="Resource" id="Resource_ivxvh"]
script = ExtResource("1_vyvsa")
character = 2
emotion = 3
speech = "we're both shapeshifters, ain't we?"

[sub_resource type="Resource" id="Resource_aqojs"]
script = ExtResource("1_vyvsa")
character = 2
emotion = 3
speech = "It's not all too often I see another one around!"

[sub_resource type="Resource" id="Resource_jgej6"]
script = ExtResource("1_vyvsa")
character = 2
emotion = 5
speech = "... unless it's the ones who've unfortunately lost their autonomy to The Force."

[sub_resource type="Resource" id="Resource_mqya6"]
script = ExtResource("1_vyvsa")
character = 2
speech = "Either way, you've got a lot to learn about this world kid. I'll be here 'til you're out of here."

[sub_resource type="Resource" id="Resource_pm0qp"]
script = ExtResource("1_vyvsa")
character = 2
emotion = 3
speech = "Farewell!"

